  "liveOnly": [
    {
      "id": "read-progress",
      "what": "'Reading configuration\u2026 n%' while a configuration is read",
      "why": "driven by the realtime channel during a live read"
    },
    {
      "id": "write-progress",
      "what": "'Writing\u2026 n%' while a configuration is written",
      "why": "driven by the realtime channel during a live write"
    }
  ],
  "notShown": [
    {
      "id": "sensors",
      "why": "Menu item shown only when the device reports sensors; the sample reports none, as the two real VideoHubs on the beta server do."
    },
    {
      "id": "high-res-retention",
      "why": "High resolution recording retention appears with firmware 1.05 and the beta front-end; the released app and firmware 1.04 do not have it."
