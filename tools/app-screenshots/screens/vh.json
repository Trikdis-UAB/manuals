      ],
      "route": "areasAndZones/partitions"
    },
    {
      "id": "cameras",
      "menu": [
        "configurators.navigation.devicesAndInterfaces",
        "configurators.navigation.devicesAndInterfacesChildren.cameras"
      ],
      "route": "devicesAndInterfaces/cameras"
    },
    {
      "id": "popup-camera-edit",
      "menu": [
        "configurators.navigation.devicesAndInterfaces",
        "configurators.navigation.devicesAndInterfacesChildren.cameras"
      ],
      "route": "devicesAndInterfaces/cameras",
      "layouts": [
        "desktop"
      ],
      "steps": [
        {
          "row": "Backyard",
          "text": "Edit"
        },
        {
          "text": "Detection options",
          "within": "section.overlay"
        }
      ],
      "crop": "section.overlay > div.content",
      "isolate": true
    },
    {
      "id": "popup-camera-streams",
      "menu": [
        "configurators.navigation.devicesAndInterfaces",
        "configurators.navigation.devicesAndInterfacesChildren.cameras"
      ],
      "route": "devicesAndInterfaces/cameras",
      "layouts": [
        "desktop"
      ],
      "steps": [
        {
          "row": "Backyard",
          "text": "Edit"
        },
        {
          "css": "app-common-input",
          "nth": 5,
          "within": "section.overlay",
          "wait": 1000
        }
      ],
      "crop": "app-camera-stream-path-popup div.pp_container_default",
      "isolate": true,
      "note": "The Camera streams pop-up opens over the camera pop-up when the Live stream path is clicked."
    },
    {
      "id": "popup-camera-masks-zones",
      "menu": [
        "configurators.navigation.devicesAndInterfaces",
        "configurators.navigation.devicesAndInterfacesChildren.cameras"
      ],
      "route": "devicesAndInterfaces/cameras",
      "layouts": [
        "desktop"
      ],
      "steps": [
        {
          "row": "Backyard",
          "text": "Edit"
        },
        {
          "text": "Detection options",
          "within": "section.overlay"
        },
        {
          "css": "app-name-value.motion-mask",
          "nth": 0,
          "within": "section.overlay",
          "wait": 2500
        }
      ],
      "crop": "section.overlay > div.content",
      "isolate": true,
      "cropLast": true
