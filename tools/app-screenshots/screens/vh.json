      "kind": "intro",
      "waitFor": "systems.titles.useAtOwnRisk"
    },
    {
      "id": "menu",
      "menu": [],
      "route": "",
      "layouts": [
        "phone"
      ],
      "note": "Phone only: the configurator menu after Read. On desktop the same menu is the left sidebar."
    },
    {
      "id": "systemoptions",
      "menu": [
        "configurators.navigation.systemOptions"
      ],
      "route": "systemOptions"
    },
    {
      "id": "communication-connection",
      "menu": [
        "configurators.navigation.communication",
        "configurators.navigation.communicationChildren.connection"
      ],
      "route": "communication/connection"
    },
